# Copia questo file in .env e compila i valori

MOCK_MODE=false
PORT=8000

# OpenAI (GPT-4o Vision per stories)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Instagram (opzionale — per stories via Playwright usa solo l'auth JSON)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Alert email
GMAIL_USER=
GMAIL_APP_PASSWORD=
